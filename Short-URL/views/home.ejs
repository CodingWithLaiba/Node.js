<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>URL Shortener</title>
</head>
<body>

  <h1>URL Shortener</h1>

  <% if (locals.id) { %>
    <p>
      URL Generated:
      <a href="http://localhost:8000/url/<%= locals.id %>" target="_blank">
        http://localhost:8000/url/<%= locals.id %>
      </a>
    </p>
  <% } %>

  <form action="/url" method="POST">
    <label for="originalUrl">Enter Your Original URL:</label>
    <input
      type="text"
      name="url"
      id="originalUrl"
      placeholder="https://example.com"
      required
    />
    <button type="submit">Generate</button>
  </form>

  <br><br>

  <% if (locals.urls && urls.length > 0) { %>

    <table border="1" cellpadding="10" cellspacing="0">
      <thead>
        <tr>
          <th>S.No</th>
          <th>Short ID</th>
          <th>Redirect URL</th>
          <th>Clicks</th>
        </tr>
      </thead>

      <tbody>
        <% urls.forEach((url, index) => { %>
          <tr>
            <td><%= index + 1 %></td>
            <td><%= url.shortID %></td>
            <td><%= url.redirectURL %></td>
            <td><%= url.visitHistory.length %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>

  <% } else { %>

    <p>No URLs found.</p>

  <% } %>

</body>
</html>